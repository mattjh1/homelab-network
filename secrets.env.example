# Copy to secrets.env and fill locally.
# Do not commit real values.

# Router connection
ROUTER_HOST=192.0.2.1
ROUTER_USER=admin
ROUTER_SSH_KEY=~/.ssh/homelab_router
ROUTER_SSH_PORT=22

# Execution control
ROUTER_SCRIPT_DIR=router
RENDERED_ROUTER_DIR=.rendered/router
APPLY_LOG_DIR=logs
APPLY_STATE_DIR=state
APPLY_CONNECT_TIMEOUT=8

# Router template variables consumed by Go rendering
ROUTER_PASSWORD=CHANGE_ME_LOCAL_ONLY
WAN_INTERFACE=ether1
MGMT_SUBNET=192.168.10.0/24
TRUSTED_CORE_ADMIN_IP=192.168.20.10
TIMEZONE_NAME=Europe/Stockholm
LAN_BRIDGE=bridge
ROUTER_AP_TRUNK_PORT=ether4
OFFICE_CORE_PORT=ether2
OFFICE_SRV_PORT=ether3
LIVINGROOM_ACCESS_PORT=ether5
MGMT_ACCESS_PORT=ether6
ADGUARD_DNS_IP=192.168.30.10
GUEST_DNS_IP=1.1.1.1
NTP_SERVER=192.168.30.10
NTP_FALLBACK=pool.ntp.org
STATIC_LEASE_IP=192.168.30.10
STATIC_LEASE_MAC=00:11:22:33:44:55
ENABLE_CAPSMAN=false
CAPSMAN_MGMT_INTERFACE=vlan-mgmt
WIFI_PASS_CORE=CHANGE_ME_CORE
WIFI_PASS_KIDS=CHANGE_ME_KIDS
WIFI_PASS_IOT=CHANGE_ME_IOT
WIFI_PASS_GUEST=CHANGE_ME_GUEST
SSID_CORE=Home
SSID_KIDS=Kids
SSID_IOT=IoT
SSID_GUEST=Guests

# AP bootstrap template variables
ENABLE_AP_CAP=false
AP_TRUNK_PORT=ether1
CAPSMAN_DISCOVERY_INTERFACE=vlan-mgmt

